{
    "extends": "./tsconfig.json",
    "compilerOptions": {
      "target": "ES2018",
      "module": "commonjs",
      "outDir": "./dist/scripts",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "types": ["node", "puppeteer", "cheerio"],
      "strict": false // Relax strictness for Node.js scripts
    },
    "include": ["scripts/**/*.ts"],
    "exclude": ["src/**/*.ts"]
  }